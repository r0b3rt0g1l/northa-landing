# ─────────────────────────────────────────────────────────────────────────────
# Northa Digital — variables de entorno
#
# Copia este archivo a .env.local para desarrollo. En Vercel se capturan en
# Project → Settings → Environment Variables (Production y Preview).
#
# TODO es opcional: sin ninguna variable el sitio compila y funciona, Nort entra
# en "modo guiado" y los formularios mandan a WhatsApp.
#
# Reglas:
#   · Las NEXT_PUBLIC_* se incrustan en el build. Si cambias una, haz un deploy
#     nuevo (commit/push); el botón "Redeploy" puede reutilizar el valor viejo.
#   · Nunca marques una NEXT_PUBLIC_* como "Sensitive" en Vercel.
#   · Las que NO empiezan con NEXT_PUBLIC_ son secretas: nunca en el navegador.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sitio ────────────────────────────────────────────────────────────────────
# URL canónica (sin diagonal final). Alimenta canonical, hreflang, sitemap,
# robots, Open Graph y JSON-LD. Default: https://northadigital.com
NEXT_PUBLIC_SITE_URL=https://northadigital.com

# Contacto público (defaults ya verificados en lib/site.ts).
NEXT_PUBLIC_WHATSAPP_NUMBER=526622055021
NEXT_PUBLIC_CONTACT_EMAIL=northadigital@gmail.com
NEXT_PUBLIC_PHONE_DISPLAY=+52 662 205 5021

# Agenda de Cal.com (liga pública). Vacía = no se ofrece agendar llamada.
NEXT_PUBLIC_CAL_URL=

# ── Nort (chat con IA) ───────────────────────────────────────────────────────
# En Vercel, Nort usa AI Gateway con la credencial OIDC del proyecto (no hace
# falta llave). Fuera de Vercel (o para forzarla) usa AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
# Modelo (formato "proveedor/modelo" de AI Gateway). Default: anthropic/claude-haiku-4.5
NORT_MODEL=
# "false" apaga la IA a mano: Nort queda en modo guiado (respuestas fijas + WhatsApp).
NORT_AI_ENABLED=

# ── Supabase (proyecto NUEVO de la landing — nunca el de los municipios) ─────
# Guarda leads y es la base de la intranet de Amplía (/amplia/portal).
# El código se niega a usar el proyecto compartido qpilnqzgsndymktgodoq.
NEXT_PUBLIC_SUPABASE_URL=
# Llave publicable (sb_publishable_…). También se acepta la anon clásica en
# NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Llave secreta (sb_secret_…): solo servidor. Leads y alta de cuentas del portal.
SUPABASE_SECRET_KEY=
# Opcional: alias del URL para el servidor (si no, usa NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=

# ── Correo de leads (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
# A quién avisar de cada lead (varios separados por coma).
LEADS_NOTIFY_EMAIL=northadigital@gmail.com
# Remitente. Mientras el dominio no esté verificado en Resend, usa el de prueba
# (onboarding@resend.dev), que solo entrega a la cuenta dueña de Resend.
LEADS_FROM_EMAIL=Northa Digital <hola@northadigital.com>
# "true" manda al prospecto un acuse genérico (sin repetir su mensaje). Solo con
# dominio verificado en LEADS_FROM_EMAIL.
LEADS_CONFIRMATION=

# ── HubSpot (opcional) ──────────────────────────────────────────────────────
# Token de una Private App con scopes crm.objects.contacts.write y notes.
HUBSPOT_ACCESS_TOKEN=

# ── Cloudflare Turnstile (opcional, anti-spam en formularios) ───────────────
# Si faltan, los formularios usan solo el campo trampa y el límite por IP.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Analytics 4 (opcional) ───────────────────────────────────────────
# Vercel Analytics (sin cookies) ya viene activo en Vercel. GA4 usa cookies:
# si lo activas, actualiza el aviso de privacidad (ver docs/05-lanzamiento.md).
NEXT_PUBLIC_GA_ID=
